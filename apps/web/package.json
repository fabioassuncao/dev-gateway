{
  "name": "portta-web",
  "version": "0.1.0",
  "private": true,
  "description": "Administration panel for Portta",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --conditions=development --watch src/server/index.ts",
    "dev:ui": "node scripts/dev-frontends.mjs",
    "dev:docs": "vite --config vite.docs.config.ts",
    "build": "npm run build:ui && npm run build:auth-ui && npm run build:docs && npm run build:server",
    "build:ui": "vite build",
    "build:auth-ui": "vite build --config vite.auth.config.ts",
    "build:docs": "vite build --config vite.docs.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openapi": "node --conditions=development src/server/generate-openapi.ts",
    "openapi:check": "node --conditions=development src/server/generate-openapi.ts --check",
    "screenshots": "npm run build && node e2e/screenshots.mjs",
    "viewports": "npm run build && node e2e/viewports.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/standard-validator": "0.2.0",
    "@standard-community/standard-json": "0.3.5",
    "@standard-community/standard-openapi": "0.2.9",
    "@types/json-schema": "7.0.15",
    "hono": "4.13.5",
    "hono-openapi": "1.3.1",
    "i18next": "^26.4.1",
    "openapi-types": "12.1.3",
    "portta-core": "0.1.0",
    "postgres": "3.4.9",
    "react-i18next": "^17.0.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "3.1.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.62.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsdom": "28.1.0",
    "lucide-react": "1.38.0",
    "markdown-it": "^14.1.0",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
