# Build context is the repository root. The panel image must never receive
# secrets, runtime state, TLS material or the git directory. tests/unit/audit.test.sh
# fails the build if these exclusions disappear.

.git
.github
.env
.env.*
!.env.example

state
config/tls
secrets
*.pem
*.key
*.crt
*.p12
acme.json
tailscaled.state
*.authkey

node_modules
**/node_modules
**/dist
**/test-results
**/playwright-report
**/.vite

apps/web/e2e
apps/web/tests
apps/web/openapi.json
apps/web/playwright.config.ts
apps/web/vitest.config.ts

docs
templates
tests
scripts
bin
*.md
AGENTS.md
CHANGELOG.md
LICENSE
Makefile
VERSION
docker
