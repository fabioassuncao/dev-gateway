# Local configuration (may contain secrets)
.env
.env.*
!.env.example

# Runtime state owned by the gateway (never commit)
state/
!state/.gitkeep

# TLS material
# Generated by `portta tls init`, alongside the certificate it points at.
config/traefik/dynamic/local-tls.yaml
config/traefik/dynamic/auth.yaml

# Generated by the panel and by `portta web auth`: they carry a password
# hash, and their contents are derived from .env.
config/traefik/dynamic/portta-panel.yaml
config/traefik/dynamic/portta-shares.yaml
config/traefik/dynamic/portta-aliases.yaml
config/tls/*
!config/tls/.gitkeep
!config/tls/README.md

# Secrets
secrets/
*.pem
*.key
*.crt
*.p12
acme.json
tailscaled.state
*.authkey

# OS / editors
.DS_Store
._*
.idea/
.vscode/
*.swp

# Workspace install and build artifacts (the image builds them; they are never committed)
node_modules/
apps/web/node_modules/
apps/*/dist/
apps/web/test-results/
apps/web/playwright-report/
apps/web/.vite/
packages/*/node_modules/
packages/*/dist/

# Test artifacts
tests/.tmp/
tests/**/.env
