# Local configuration (may contain secrets)
.env
.env.*
!.env.example

# Runtime state owned by the gateway (never commit)
state/
!state/.gitkeep

# TLS material
# Generated by `dev-gateway tls init`, alongside the certificate it points at.
config/traefik/dynamic/local-tls.yaml
config/traefik/dynamic/auth.yaml
config/tls/*
!config/tls/.gitkeep
!config/tls/README.md

# Secrets
secrets/
*.pem
*.key
*.crt
*.p12
acme.json
tailscaled.state
*.authkey

# OS / editors
.DS_Store
._*
.idea/
.vscode/
*.swp

# Web panel build artifacts (the image builds them; they are never committed)
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/.vite/

# Test artifacts
tests/.tmp/
tests/**/.env
